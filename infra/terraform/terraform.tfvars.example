# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
region       = "ap-south-1"
ssh_key_name = "devops-pratice"
ssh_cidr     = "203.0.113.7/32"   # your IP: curl https://checkip.amazonaws.com, then add /32
repo_url     = "https://github.com/<you>/<repo>.git"
domain       = ""                 # optional: your own hostname
budget_email = "you@example.com"  # optional cost alert
