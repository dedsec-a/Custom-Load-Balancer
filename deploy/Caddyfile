# SITE_ADDRESS comes from docker-compose (.env). ":80" = plain HTTP;
# a hostname such as 13-233-10-20.sslip.io = automatic HTTPS via Let's Encrypt.
{$SITE_ADDRESS::80} {
	# Prometheus metrics stay on the private network.
	handle /metrics {
		respond 404
	}

	# Visitors can send their own traffic through the load balancer:
	#   curl https://<host>/traffic/browse
	handle_path /traffic/* {
		reverse_proxy lb:8080
	}

	# Dashboard + admin API (+ live SSE stream).
	handle {
		encode {
			gzip
			match {
				header Content-Type text/html*
				header Content-Type text/css*
				header Content-Type text/javascript*
				header Content-Type application/javascript*
				header Content-Type application/json*
			}
		}
		reverse_proxy lb:8081 {
			flush_interval -1
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
