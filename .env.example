# Copy to .env on the server and fill in.

# Public hostname. With no domain, use your EC2 public IP with dashes + .sslip.io
# (e.g. IP 13.233.10.20 -> 13-233-10-20.sslip.io). Leave unset for plain HTTP on :80.
SITE_ADDRESS=

# Optional: require a login (user "admin") for the whole dashboard.
LB_ADMIN_PASSWORD=

# Most virtual users visitors may start (keep it modest on a t3.micro).
MAX_USERS=300
